{
  "version": "2.2.0",
  "description": "Programming font built on Iosevka without programming ligatures (Normal width, Hinted).",
  "homepage": "https://github.com/ahatem/IoskeleyMono",
  "license": "OFL-1.1",
  "url": "https://github.com/ahatem/IoskeleyMono/releases/download/v2.2.0/IoskeleyMono-NL.zip",
  "hash": "1891c98f696f4eabca2486ec6da1aa5576aa936fda5f3ef24b360b49e8e58948",
  "extract_dir": "Normal\\Hinted",
  "pre_install": [
    "$build = [int](Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion').CurrentBuildNumber",
    "if (!$global -and $build -lt 17763) { throw 'Per-user font installation requires Windows 10 1809 or later. Use a global install on older systems.' }"
  ],
  "installer": {
    "script": [
      "if (-not ('ScoopIoskeley.NativeFonts' -as [type])) {",
      "    Add-Type -TypeDefinition @'",
      "using System;",
      "using System.Runtime.InteropServices;",
      "namespace ScoopIoskeley {",
      "    public static class NativeFonts {",
      "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        public static extern int AddFontResourceExW(string path, uint flags, IntPtr reserved);",
      "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        [return: MarshalAs(UnmanagedType.Bool)]",
      "        public static extern bool RemoveFontResourceExW(string path, uint flags, IntPtr reserved);",
      "        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        [return: MarshalAs(UnmanagedType.Bool)]",
      "        public static extern bool SendNotifyMessageW(IntPtr window, uint message, UIntPtr wParam, IntPtr lParam);",
      "    }",
      "}",
      "'@",
      "}",
      "$fontDir = if ($global) { Join-Path $env:WINDIR 'Fonts' } else { Join-Path $env:LOCALAPPDATA 'Microsoft\\Windows\\Fonts' }",
      "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
      "$fontKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
      "if (!(Test-Path -LiteralPath $fontDir)) { New-Item -ItemType Directory -Path $fontDir -ErrorAction Stop | Out-Null }",
      "if (!(Test-Path -LiteralPath $fontKey)) { New-Item -Path $fontKey -Force -ErrorAction Stop | Out-Null }",
      "if (!$global) {",
      "    $acl = Get-Acl -LiteralPath $fontDir",
      "    foreach ($sid in @('S-1-15-2-1', 'S-1-15-2-2')) {",
      "        $rule = [System.Security.AccessControl.FileSystemAccessRule]::new([System.Security.Principal.SecurityIdentifier]::new($sid), 'ReadAndExecute', 'ContainerInherit,ObjectInherit', 'None', 'Allow')",
      "        $acl.SetAccessRule($rule)",
      "    }",
      "    Set-Acl -LiteralPath $fontDir -AclObject $acl -ErrorAction Stop",
      "}",
      "$fonts = @(Get-ChildItem -LiteralPath $dir -Filter '*.ttf' -File)",
      "if (!$fonts.Count) { throw 'No TTF files found. Check the release archive and extract_dir.' }",
      "foreach ($font in $fonts) {",
      "    $target = Join-Path $fontDir $font.Name",
      "    if (!(Test-Path -LiteralPath $target) -or (Get-FileHash -LiteralPath $target).Hash -ne (Get-FileHash -LiteralPath $font.FullName).Hash) {",
      "        Copy-Item -LiteralPath $font.FullName -Destination $target -Force -ErrorAction Stop",
      "    }",
      "    $value = if ($global) { $font.Name } else { $target }",
      "    New-ItemProperty -Path $fontKey -Name ($font.BaseName + ' (TrueType)') -Value $value -PropertyType String -Force -ErrorAction Stop | Out-Null",
      "    if ([ScoopIoskeley.NativeFonts]::AddFontResourceExW($target, 0, [IntPtr]::Zero) -eq 0) { throw \"Windows could not load font: $target\" }",
      "}",
      "[void][ScoopIoskeley.NativeFonts]::SendNotifyMessageW([IntPtr]::new(0xffff), 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)"
    ]
  },
  "pre_uninstall": [
    "if (-not ('ScoopIoskeley.NativeFonts' -as [type])) {",
    "    Add-Type -TypeDefinition @'",
    "using System;",
    "using System.Runtime.InteropServices;",
    "namespace ScoopIoskeley {",
    "    public static class NativeFonts {",
    "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
    "        public static extern int AddFontResourceExW(string path, uint flags, IntPtr reserved);",
    "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
    "        [return: MarshalAs(UnmanagedType.Bool)]",
    "        public static extern bool RemoveFontResourceExW(string path, uint flags, IntPtr reserved);",
    "        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
    "        [return: MarshalAs(UnmanagedType.Bool)]",
    "        public static extern bool SendNotifyMessageW(IntPtr window, uint message, UIntPtr wParam, IntPtr lParam);",
    "    }",
    "}",
    "'@",
    "}",
    "$fontDir = if ($global) { Join-Path $env:WINDIR 'Fonts' } else { Join-Path $env:LOCALAPPDATA 'Microsoft\\Windows\\Fonts' }",
    "$unloadedFonts = @()",
    "try {",
    "    foreach ($font in Get-ChildItem -LiteralPath $dir -Filter '*.ttf' -File) {",
    "        $target = Join-Path $fontDir $font.Name",
    "        if (Test-Path -LiteralPath $target) {",
    "            $count = 0",
    "            while ([ScoopIoskeley.NativeFonts]::RemoveFontResourceExW($target, 0, [IntPtr]::Zero)) { $count++ }",
    "            $unloadedFonts += [PSCustomObject]@{ Path = $target; Count = $count }",
    "            Rename-Item -LiteralPath $target -NewName $font.Name -ErrorAction Stop",
    "        }",
    "    }",
    "} catch {",
    "    foreach ($entry in $unloadedFonts) {",
    "        for ($i = 0; $i -lt $entry.Count; $i++) { [void][ScoopIoskeley.NativeFonts]::AddFontResourceExW($entry.Path, 0, [IntPtr]::Zero) }",
    "    }",
    "    [void][ScoopIoskeley.NativeFonts]::SendNotifyMessageW([IntPtr]::new(0xffff), 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)",
    "    throw \"Cannot unload Ioskeley fonts. Close applications using them and retry. $($_.Exception.Message)\"",
    "}",
    "[void][ScoopIoskeley.NativeFonts]::SendNotifyMessageW([IntPtr]::new(0xffff), 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)"
  ],
  "uninstaller": {
    "script": [
      "if (-not ('ScoopIoskeley.NativeFonts' -as [type])) {",
      "    Add-Type -TypeDefinition @'",
      "using System;",
      "using System.Runtime.InteropServices;",
      "namespace ScoopIoskeley {",
      "    public static class NativeFonts {",
      "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        public static extern int AddFontResourceExW(string path, uint flags, IntPtr reserved);",
      "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        [return: MarshalAs(UnmanagedType.Bool)]",
      "        public static extern bool RemoveFontResourceExW(string path, uint flags, IntPtr reserved);",
      "        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
      "        [return: MarshalAs(UnmanagedType.Bool)]",
      "        public static extern bool SendNotifyMessageW(IntPtr window, uint message, UIntPtr wParam, IntPtr lParam);",
      "    }",
      "}",
      "'@",
      "}",
      "$fontDir = if ($global) { Join-Path $env:WINDIR 'Fonts' } else { Join-Path $env:LOCALAPPDATA 'Microsoft\\Windows\\Fonts' }",
      "$registryRoot = if ($global) { 'HKLM' } else { 'HKCU' }",
      "$fontKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
      "Get-ChildItem -LiteralPath $dir -Filter '*.ttf' -File | ForEach-Object {",
      "    $target = Join-Path $fontDir $_.Name",
      "    if (Test-Path -LiteralPath $target) {",
      "        while ([ScoopIoskeley.NativeFonts]::RemoveFontResourceExW($target, 0, [IntPtr]::Zero)) {}",
      "        try { Remove-Item -LiteralPath $target -Force -ErrorAction Stop }",
      "        catch {",
      "            [void][ScoopIoskeley.NativeFonts]::AddFontResourceExW($target, 0, [IntPtr]::Zero)",
      "            [void][ScoopIoskeley.NativeFonts]::SendNotifyMessageW([IntPtr]::new(0xffff), 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)",
      "            throw \"Cannot delete font: $target. Close applications using it and retry. $($_.Exception.Message)\"",
      "        }",
      "    }",
      "    Remove-ItemProperty -Path $fontKey -Name ($_.BaseName + ' (TrueType)') -Force -ErrorAction SilentlyContinue",
      "}",
      "[void][ScoopIoskeley.NativeFonts]::SendNotifyMessageW([IntPtr]::new(0xffff), 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)"
    ]
  },
  "notes": [
    "TTF fonts are installed, registered and loaded automatically. Restart applications that cache their font lists.",
    "Font family: Ioskeley Mono NL. This package installs 20 Normal-width styles.",
    "Close applications using these fonts before updating or uninstalling."
  ],
  "checkver": "github",
  "autoupdate": {
    "url": "https://github.com/ahatem/IoskeleyMono/releases/download/v$version/IoskeleyMono-NL.zip"
  }
}
